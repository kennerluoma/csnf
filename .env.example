# Public: baked into the client bundle. Set the same values in the Cloudflare Worker build.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Scripts (pnpm seed / pages / extract). Never committed; the local runner writes these per build.
SANITY_WRITE_TOKEN=
FIGMA_TOKEN=

# Worker secrets for the contact form (set as GitHub repo secrets; deploy.yml pushes them to the Worker).
# SANITY_WRITE_TOKEN  stores submissions          RESEND_API_KEY   emails siteSettings.contactEmail
# CONTACT_FROM        sender address for Resend   TURNSTILE_SECRET_KEY + TURNSTILE_SITE_KEY  spam check
