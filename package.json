{
  "name": "csnf",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node --experimental-strip-types scripts/static-data.ts",
    "preview": "pnpm build && wrangler dev",
    "lint": "oxlint --type-aware",
    "format": "oxfmt && oxlint --type-aware --fix",
    "check": "oxfmt --check",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check:compiler": "COMPILER_REPORT=1 vite build",
    "dev:admin": "pnpm --filter admin dev",
    "build:admin": "pnpm --filter admin build",
    "seed": "node --env-file=.env --experimental-strip-types scripts/seed.ts",
    "pages": "node --env-file=.env --experimental-strip-types scripts/pages.ts",
    "extract": "node --env-file=.env --experimental-strip-types scripts/extract.ts",
    "shot": "node --env-file=.env --experimental-strip-types scripts/shot.ts",
    "inventory": "node --experimental-strip-types scripts/inventory.ts",
    "budget": "node --experimental-strip-types scripts/budget.ts",
    "audit": "pnpm audit --prod --audit-level high",
    "typegen": "node --experimental-strip-types scripts/typegen.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.6.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/types": "^6.13.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.0.0",
    "clsx": "^2.1.1",
    "groq": "^6.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "^0.8.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "packageManager": "pnpm@11.21.0",
  "budgets": {
    "jsGzipKB": 200,
    "clickMs": 150
  }
}
