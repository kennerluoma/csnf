{
  "name": "csnf",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node --experimental-strip-types scripts/static-data.ts",
    "preview": "pnpm build && wrangler dev",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check:compiler": "COMPILER_REPORT=1 vite build",
    "sanity:typegen": "pnpm --filter studio typegen",
    "dev:studio": "pnpm --filter studio dev",
    "build:studio": "pnpm --filter studio build",
    "seed": "node --env-file=.env --experimental-strip-types scripts/seed.ts",
    "pages": "node --env-file=.env --experimental-strip-types scripts/pages.ts",
    "extract": "node --env-file=.env --experimental-strip-types scripts/extract.ts",
    "shot": "node --env-file=.env --experimental-strip-types scripts/shot.ts",
    "inventory": "node --experimental-strip-types scripts/inventory.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.6.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/types": "^6.14.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "packageManager": "pnpm@11.21.0"
}
